{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "endless-keep-leaderboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    // only these pages may submit scores (anyone may read the board)
    "ALLOWED_ORIGINS": "https://keep.watchtogether.uk,https://endless-keep.pages.dev,https://adamworley.github.io,http://localhost:8420"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "endless-keep-leaderboard", "database_id": "c698067c-5de7-4811-8732-34cf760820e5" }
  ],
  "observability": { "enabled": true },
  // branch preview builds: same rules, but their own test database so they never touch the real Hall of Heroes.
  // Previews don't get the production secrets, so they run with no HASH_SALT and no Turnstile check.
  "previews": {
    "vars": {
      "ALLOWED_ORIGINS": "https://keep.watchtogether.uk,https://endless-keep.pages.dev,https://adamworley.github.io,http://localhost:8420"
    },
    "d1_databases": [
      { "binding": "DB", "database_name": "endless-keep-leaderboard-preview", "database_id": "04d26651-df0b-48ee-88de-6fcf648d00fe" }
    ]
  }
}
